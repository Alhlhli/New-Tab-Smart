{
  "manifest_version": 3,
  "name": "New Tab Smart",
  "version": "1.1.0",
  "description": "لوحة الصلاة والطقس وتدبر القرآن والأذكار وأدوات الذكاء الاصطناعي",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "action": {
    "default_title": "New Tab Smart",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "geolocation"
  ]
}
